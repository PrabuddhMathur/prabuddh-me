# Copy to .env to change these when running Nuxt directly (npm run dev / npm run preview).
# Docker Compose sets NUXT_BACKEND_URL itself.

# Where the Nuxt server reaches the Wagtail backend. In development it is also where
# /api/, /media/ and /documents/ are proxied to. Default: http://localhost:8000
# NUXT_BACKEND_URL=http://localhost:8000

# The site's public address, used for canonical and Open Graph URLs. Default: http://localhost:3000
# NUXT_PUBLIC_SITE_URL=https://prabuddh.in
