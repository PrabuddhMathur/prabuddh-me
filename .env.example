# Used by docker-compose.prod.yaml. Copy to .env on the server.
# Django's own settings live in backend/.env (see backend/.env.example).

# The site's domain. Caddy gets HTTPS certificates for it and for www.<DOMAIN>,
# which redirects to it. Also becomes the frontend's public URL (https://<DOMAIN>,
# NUXT_PUBLIC_SITE_URL) for canonical and Open Graph links.
DOMAIN=prabuddh.in
