# syntax=docker/dockerfile:1

# Development images, used by docker-compose.dev.yaml.
# Build context is the repository root; pick an app with --target backend or --target frontend.
# Source code is bind-mounted at runtime, so these images only hold the toolchain and dependencies.
# Keep base image tags in step with Dockerfile.prod and docs/versions.md.


# ---------------------------------------------------------------------------
# Backend: Django/Wagtail dev server with auto-reload
# ---------------------------------------------------------------------------
FROM python:3.14.7-slim-trixie AS backend

COPY --from=ghcr.io/astral-sh/uv:0.12.21 /uv /bin/uv

# The virtualenv lives outside /app, so the bind-mounted source (which may contain
# the host's own backend/.venv) can't hide it.
ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked

EXPOSE 8000
CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py runserver 0.0.0.0:8000"]


# ---------------------------------------------------------------------------
# Frontend: Nuxt dev server with hot reload
# ---------------------------------------------------------------------------
FROM node:24.21.0-trixie-slim AS frontend

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
