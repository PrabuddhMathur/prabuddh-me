# Copy to backend/.env and uncomment what you need. Locally every setting has a
# working default, so this file is mainly for production or to override something.

# --- Public URLs ---------------------------------------------------------------
# Required in production, where both are https://prabuddh.in (one domain behind Caddy).
# WAGTAILADMIN_BASE_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:3000

# --- Production only -----------------------------------------------------------
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
# SECRET_KEY=
# "backend" lets the Nuxt server call the API directly over the Docker network.
# ALLOWED_HOSTS=prabuddh.in,www.prabuddh.in,backend
# CSRF_TRUSTED_ORIGINS=https://prabuddh.in,https://www.prabuddh.in
# HSTS duration in seconds. Raise to 31536000 once HTTPS is confirmed working.
# SECURE_HSTS_SECONDS=3600
# LOG_LEVEL=INFO

# --- Storage -------------------------------------------------------------------
# SQLite database file (default: backend/data/db.sqlite3, which is /app/data in Docker)
# SQLITE_PATH=/some/other/path/db.sqlite3
# Uploaded images and documents (default: backend/media, which is /app/media in Docker)
# MEDIA_ROOT=/some/other/path/media

# --- Email (the newsletter) -----------------------------------------------------
# Confirmation emails go out from the web server, post emails from the worker.
# Without these the site still runs; signups just can't be confirmed.
# Production example, Gmail with an app password (see docs/newsletter-production.md):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# EMAIL_TIMEOUT=20
# DEFAULT_FROM_EMAIL=Prabuddh's Blog <you@gmail.com>
# SERVER_EMAIL=you@gmail.com
# Optional Reply-To on newsletter emails:
# NEWSLETTER_REPLY_TO=you@gmail.com
# Seconds between two post emails, and signup requests allowed per IP per hour:
# NEWSLETTER_SEND_DELAY=1.0
# NEWSLETTER_SUBSCRIBE_LIMIT=10
# Defaults to SMTP; the dev settings default to printing emails in the terminal.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#
# Local testing with Mailpit (just mailpit; inbox at http://localhost:8025):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_USE_TLS=False
